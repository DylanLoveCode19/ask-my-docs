# Copy to .env and fill in. Never commit .env.
# M0 setup, lint and tests require no credentials or external services.

# --- LLM (any OpenAI-compatible endpoint) ---
# Pick the cheapest option that works for you (free tiers exist at several providers;
# check current limits and prices before choosing). Examples of base URLs:
#   Gemini (OpenAI-compat): https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq:                   https://api.groq.com/openai/v1
#   OpenRouter:             https://openrouter.ai/api/v1
#   OpenAI:                 https://api.openai.com/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Judge for Ragas can be the same or a different model
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=

# Price per 1M tokens in USD; these override config/app.yaml (0 for free tiers).
LLM_PRICE_INPUT_PER_M=0
LLM_PRICE_OUTPUT_PER_M=0

# --- Langfuse (cloud free tier) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
